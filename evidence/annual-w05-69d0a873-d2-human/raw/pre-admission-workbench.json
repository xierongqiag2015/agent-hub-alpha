      ],
      "id": "check1",
      "kind": "check",
      "name": "数值/期间/口径/来源检查",
      "role": "程序检查",
      "status": "pending",
      "task": "对 revise1 修订稿执行与 check0 同分支的确定性复检，输出 check/1 结论 PASS 或 REVISE。",
      "when": {
        "contains": "REVISE",
        "step": "check0"
      }
    },
    {
