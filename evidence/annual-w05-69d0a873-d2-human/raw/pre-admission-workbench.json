          "version": "1.0.0"
        },
        "kind": "agent_bus",
        "path_mode": "DIRECT"
      },
      "id": "draft0",
      "kind": "write",
      "name": "报告写作与一次修订",
      "role": "报告写作",
      "status": "pending",
      "task": "汇总 business 与 quality 两路分析，撰写本集团2025对比2024经营与资产质量简报初稿，覆盖全部八项指标及其来源标注，结构完整、口径与期间表述一致，不得出现材料之外的数值。"
    },
    {
      "activity": "",
      "contract": "checker@1",
      "deps": [
        "draft0"
      ],
      "id": "check0",
      "kind": "check",
      "name": "数值/期间/口径/来源检查",
      "role": "程序检查",
      "status": "pending",
      "task": "对 draft0 执行确定性检查：八项指标是否齐全、数值与期间口径是否与提取结果一致、来源标注是否可追溯、是否存在材料外内容；输出 check/1 结论 PASS 或 REVISE。"
    },
    {
      "activity": "",
      "contract": "writer@1",
      "deps": [
        "draft0",
        "check0"
      ],
      "execution": {
        "binding": {
          "agent_id": "report-writer",
          "version": "1.0.0"
        },
        "kind": "agent_bus",
        "path_mode": "DIRECT"
      },
      "id": "revise1",
      "kind": "write",
      "name": "报告写作与一次修订",
      "role": "报告一次定向修订",
      "status": "pending",
      "task": "仅在 check0 结论为 REVISE 时执行：按 check0 的具体问题对 draft0 做一次定向修订，形成修订稿，保持其余内容不变，输出 report/1。",
      "when": {
        "contains": "REVISE",
        "step": "check0"
      }
    },
